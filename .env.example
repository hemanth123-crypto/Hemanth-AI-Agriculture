# Environment Configuration for AI-Powered Agriculture Crop Advisory Assistant

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# LLM Configuration (OpenAI Compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30

# Embedding Configuration
EMBEDDING_PROVIDER=dense_local  # Options: dense_local, sentence_transformers, openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=128

# RAG & Retrieval
RETRIEVAL_TOP_K=5
ALPHA_SEMANTIC=0.50
BETA_KEYWORD=0.30
GAMMA_METADATA=0.20

# Evaluation & Guardrails
LLM_JUDGE_MIN_SCORE=0.70
DEEPEVAL_ENABLED=False
GUARDRAIL_STRICT_MODE=True

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
INDEXES_DIR=indexes
FEEDBACK_FILE=data/feedback_store.json
